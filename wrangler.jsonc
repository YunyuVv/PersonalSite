{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "GITHUB_REPO": "YunyuVv/PersonalSite",
    "GITHUB_BRANCH": "main"
  }
}
